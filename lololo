program TaskTwo;
type
    listptr = ^list;
    list = record 
        data: integer;
        next: listptr;
    end;
{
procedure Add(var first, endik: listptr);
var
    beg: listptr;
begin
    beg := first;
    while true do
    begin
        if first^.next = nil then
            break;
        first := first^.next;
    end;
    first^.next := endik;
    endik^.next := nil;
    first := beg;
end;
}
{
procedure Wrote(endl, cur: listptr);
begin
    if not (cur = endl) then
    begin
        write(cur^.data, ' ');
        cur := cur^.next;
        Wrote(endl, cur);
    end
    else
        write(cur^.data);
end;
}

